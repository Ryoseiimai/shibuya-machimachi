{
  "name": "shibuya-machimachi dev",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22",
  "postCreateCommand": "cd worker && npm install",
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "shibuya-machimachi (dev mode)",
      "onAutoForward": "openPreview"
    }
  },
  "postAttachCommand": "echo 'Run: npm run dev   (or: make dev)'",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
