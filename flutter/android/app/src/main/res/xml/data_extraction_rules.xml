<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 以降: クラウドのバックアップにも、機種変更の端末間転送にも何も載せない
     （待ち合わせの一時的な鍵は secure storage＝sharedpref にある。ほかに残す価値のあるデータも無い） -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
