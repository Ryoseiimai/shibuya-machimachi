{
  "name": "shibuya-machimachi-ios",
  "private": true,
  "description": "渋谷マチマチ iOSアプリ(Capacitor)。画面は worker/ のHTML/JS/3D部品をアプリに同梱し、通信だけ本番Workerへ行う。",
  "type": "module",
  "scripts": {
    "build:www": "node scripts/build-www.mjs",
    "sync": "node scripts/build-www.mjs && npx cap sync ios",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/geolocation": "8.2.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "8.0.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  }
}
